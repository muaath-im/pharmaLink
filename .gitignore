# Environment variables (contains sensitive local credentials)
.env

# Scratch and temporary testing files
scratch/
test_cookie.txt

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# IDE and Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Temporary & Log files
*.log
*.tmp


# === Storage: ignore runtime data, keep folder placeholders ===
storage/cache/*
storage/logs/*
storage/uploads/prescriptions/*

# Keep the directory structure in Git
!storage/cache/.gitkeep
!storage/logs/.gitkeep
!storage/uploads/prescriptions/.gitkeep
